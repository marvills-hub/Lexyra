{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lexyra",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-29",
  "ai": {
    "binding": "AI",
  },
  "assets": {
    "directory": "./dist/lexyra/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
